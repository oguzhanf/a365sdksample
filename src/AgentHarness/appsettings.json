  },
  "Harness": {
    "TenantId": "",
    "TenantName": "Your organization",
    "AllowedB2BGuestObjectIds": [],
    "AllowedB2BGuestAdministratorObjectIds": [],
    "ClientId": "",
    "ServicePrincipalId": "",
    "InternalApiClientId": "",
    "InternalApiServicePrincipalId": "",
    "GraviteeClientId": "",
    "GraviteeServicePrincipalId": "",
    "ResourceGroup": "rg-agentharness-demo",
    "SubscriptionId": "",
    "PublicUrl": "",
