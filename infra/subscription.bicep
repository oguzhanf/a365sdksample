targetScope = 'subscription'

@description('Location for the resource group and regional resources.')
param location string = 'eastus'

@description('Non-secret deployment settings generated by Deploy.ps1. No subscription is selected implicitly.')
param configuration object

resource group 'Microsoft.Resources/resourceGroups@2025-04-01' = {
  name: configuration.resourceGroupName
  location: location
  tags: {
    application: 'AgentHarness'
    environment: 'demo'
  }
}

module infrastructure './main.bicep' = {
  name: 'agentharness-agent-harness-resources'
  scope: group
  params: {
    location: location
    configuration: configuration
  }
}

module securityReader './subscription-security.bicep' = {
  name: 'agentharness-agent-harness-security-reader'
  params: {
    principalId: infrastructure.outputs.harnessPrincipalId
  }
}

output deployment object = infrastructure.outputs.deployment
